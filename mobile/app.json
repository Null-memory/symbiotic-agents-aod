{
  "expo": {
    "name": "AOD Mobile",
    "slug": "aod-mobile",
    "version": "0.2.0",
    "orientation": "default",
    "scheme": "aodmobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.aod.mobile",
      "versionCode": 1,
      "predictiveBackGestureEnabled": true
    },
    "plugins": ["expo-router", "expo-secure-store", "./plugins/with-cleartext-aod"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
