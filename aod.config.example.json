{
  "agents": {
    "codex": {
      "command": "codex",
      "args": ["exec", "--sandbox", "workspace-write", "{{prompt}}"]
    },
    "claude-code": {
      "command": "claude",
      "args": ["--print", "--permission-mode", "acceptEdits", "{{prompt}}"]
    },
    "antigravity": {
      "command": "antigravity",
      "args": ["chat", "--mode", "agent", "-"],
      "stdin": "{{prompt}}"
    }
  }
}
